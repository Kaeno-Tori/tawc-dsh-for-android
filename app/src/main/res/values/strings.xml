    <!-- Setup flow. The app is single-purpose — hand the user to DSH — so
         the no-container state is a guided step, not a home screen listing
         features. Sizes are measured: the Arch Linux ARM bootstrap tarball
         is 829,367,415 bytes, and a provisioned container plus DSH lands
         near 1.5 GB. -->
    <string name="setup_title">Set up DSH</string>
