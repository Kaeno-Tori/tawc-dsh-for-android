<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Bootstrap tarballs are downloaded directly by the install package. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- DshService keeps the agent's shell session alive across Activity
         lifecycles; specialUse is its correct foregroundServiceType on
         Android 14+ (see the service below). InstallationService runs the
         long-running install/uninstall flow as dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- All-files access backs the external-storage bind feature
         (notes/external-binds.md): the user binds e.g.
         /storage/emulated/0 into a rootfs as /home/android so Linux
         apps see shared storage directly. Google Play treats this as a
         sensitive permission; `-PtawcAllFilesAccess=false` strips it at
         build time (see app/build.gradle.kts) and the app then hides
         the binds UI (AllFilesAccess.declared). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      extractNativeLibs="true": the rootless install method ships proot
      as jniLibs/<abi>/libproot.so and exec's it from nativeLibraryDir.
      execve needs a real on-disk inode, which only happens when the OS
      extracts native libs out of the APK. Without this attribute, AGP
      defaults to page-aligned-in-APK loading (good for dlopen, useless
      for exec), which would shadow the proot binary's executability.
    -->
    <application
        android:name=".TawcApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Tawc"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The DSH surface: the agent's own browser UI in a WebView, with
             the harness kept alive by DshService. Not exported — the only
             launcher is the home-screen button. See
             TAWC_DSH_DESIGN.md §2. -->
        <activity
            android:name=".dsh.DshActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- Keeps the DSH harness (and therefore the guest process tree,
             which lives in this app's cgroup) off the LMK/freezer path, and
             keeps the app's network access alive once backgrounded — without
             an FGS the light-Doze fw_dozable chain cuts the uid's traffic
             after about a minute. specialUse because none of the standard
             types describe "an AI agent is working"; dataSync carries a
             daily time limit on recent releases. See
             TAWC_DSH_DESIGN.md §4. -->
        <service
            android:name=".dsh.DshService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ai_agent" />
        </service>

        <activity
            android:name=".install.InstallActivity"
            android:exported="false"
            android:label="@string/title_install_distro" />

        <activity
            android:name=".install.DistroInfoActivity"
            android:exported="false"
            android:label="@string/title_distro_info" />

        <activity
            android:name=".install.InstallMethodInfoActivity"
            android:exported="false"
            android:label="@string/title_install_methods" />

        <activity
            android:name=".install.ManageBindsActivity"
            android:exported="false"
            android:label="@string/title_manage_binds" />

        <activity
            android:name=".install.DirectoryPickerActivity"
            android:exported="false"
            android:label="@string/title_directory_picker" />

        <activity
            android:name=".tasks.TaskManagerActivity"
            android:exported="false"
            android:label="@string/title_task_manager" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <activity
            android:name=".licenses.LicensesActivity"
            android:exported="false"
            android:label="@string/title_licenses" />

        <activity
            android:name=".licenses.LicenseSectionActivity"
            android:exported="false"
            android:label="@string/title_licenses" />

        <!-- Generic per-operation log viewer. Pure viewer: opening it
             never triggers any operation. Exported in debug builds
             only (placeholder set per build type in build.gradle.kts)
             so an am start with operationId from adb can attach to a
             running op (e.g. one started via the dev exec broker);
             release builds keep it app-internal. -->
        <activity
            android:name=".ops.LogScreenActivity"
            android:exported="${logScreenExported}"
            android:label="@string/title_operation_log" />

        <!-- Notification "Cancel" action target. Looks up the named op
             in OperationsRegistry and calls Operation.cancel(). Bypasses
             cancelConfirmation — a notification-action tap is itself the
             deliberate decision. PendingIntents target this receiver via
             explicit ComponentName, so no intent-filter is needed. -->
        <receiver
            android:name=".ops.CancelOperationReceiver"
            android:exported="false" />

        <!-- In-app terminal, one per distro. documentLaunchMode=
             "intoExisting" makes the system reuse an existing task for
             a relaunch of the same document instead of stacking a
             second instance: combined with taskAffinity="" (each
             document gets its own task) + a unique tawc://terminal/<id>
             data URI, each distro's terminal gets its own recents card
             and the running instance is reused on relaunch. The shell
             session itself lives in TerminalSessions, so
             relaunch/rotation reattaches instead of respawning.
             adjustResize so the soft keyboard resizes the terminal
             grid. -->
        <activity
            android:name=".terminal.TerminalActivity"
            android:exported="false"
            android:documentLaunchMode="intoExisting"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".install.InstallationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
